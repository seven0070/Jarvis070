{
  "mcpServers": {
    "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "./workspace"] },
    "github": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"], "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" } },
    "puppeteer": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-puppeteer"] },
    "playwright": { "command": "npx", "args": ["-y", "@anthropic/mcp-playwright"] },
    "computer-use": { "command": "npx", "args": ["-y", "@anthropic/mcp-computer-use"] },
    "fetch": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-fetch"] },
    "brave-search": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-brave-search"], "env": { "BRAVE_API_KEY": "${BRAVE_API_KEY}" } },
    "perplexity": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-perplexity"], "env": { "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}" } },
    "memory": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"] },
    "sequential-thinking": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"] },
    "postgres": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres"], "env": { "POSTGRES_CONNECTION_STRING": "${DATABASE_URL}" } },
    "sqlite": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "./jarvis.db"] },
    "supabase": { "command": "npx", "args": ["-y", "@supabase/mcp-server-supabase"], "env": { "SUPABASE_ACCESS_TOKEN": "${SUPABASE_TOKEN}" } },
    "stripe": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-stripe"], "env": { "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}" } },
    "gmail": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-gmail"] },
    "google-drive": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-gdrive"] },
    "google-calendar": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-google-calendar"] },
    "slack": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-slack"], "env": { "SLACK_BOT_TOKEN": "${SLACK_TOKEN}" } },
    "notion": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-notion"], "env": { "NOTION_API_KEY": "${NOTION_API_KEY}" } },
    "linear": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-linear"], "env": { "LINEAR_API_KEY": "${LINEAR_API_KEY}" } },
    "vercel": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-vercel"], "env": { "VERCEL_TOKEN": "${VERCEL_TOKEN}" } },
    "sentry": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sentry"], "env": { "SENTRY_AUTH_TOKEN": "${SENTRY_TOKEN}" } },
    "posthog": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-posthog"], "env": { "POSTHOG_API_KEY": "${POSTHOG_KEY}" } }
  }
}
